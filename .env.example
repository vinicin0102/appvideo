# Copie para .env.local (ignorado pelo Git) e preencha.

# Chave da API da Higgsfield no formato key-id:key-secret (cloud.higgsfield.ai).
HF_CREDENTIALS=

# Senha para abrir o app. Sem ela, o app só aceita acesso deste computador.
# Obrigatória se o app ficar na internet: cada geração gasta créditos.
APP_PASSWORD=

PORT=3000
